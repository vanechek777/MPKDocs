@inject IApiEndpointStore ApiEndpoints
@inject IJSRuntime JS
@inject HttpClient Http

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            ApiEndpoints.AttachJs(JS);
            ApiEndpoints.AttachHttp(Http);
            if (!ApiEndpoints.IsLoaded)
                await ApiEndpoints.LoadAsync();
            else
                await ApiEndpoints.RefreshFromServerAsync();

            await JS.InvokeVoidAsync("MPKDocuments.bootstrapUxFromStorage");
        }
        catch
        {
            /* WebView без localStorage */
        }
    }
}
