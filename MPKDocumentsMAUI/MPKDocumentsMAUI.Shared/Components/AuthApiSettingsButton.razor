@inject IApiPingLiveService PingLive
@implements IAsyncDisposable

<button type="button"
        class="auth-api-settings-btn"
        title="Настройки"
        aria-label="Настройки приложения"
        @onclick="OpenAsync">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3" />
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
    </svg>
</button>

@if (_open)
{
    <div class="modal-overlay auth-api-settings-overlay" @onclick="CloseAsync">
        <div class="modal-card auth-api-settings-modal" @onclick:stopPropagation="true">
            <div class="modal-header">Настройки</div>
            <div class="modal-body">
                <div class="auth-settings-section">
                    <div class="auth-settings-section-title">Оформление</div>
                    <DarkThemeToggle />
                </div>

                <div class="auth-settings-section">
                    <div class="auth-settings-section-title">Подключение к серверу</div>
                    <p class="auth-api-settings-intro">
                        Выберите адрес API, через который приложение входит и загружает документы.
                    </p>
                    <ApiEndpointSettings />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Готово</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private bool _pingHeld;

    private async Task OpenAsync()
    {
        _open = true;
        if (!_pingHeld)
        {
            PingLive.Acquire();
            _pingHeld = true;
            try
            {
                await PingLive.RefreshNowAsync();
            }
            catch
            {
                /* сеть */
            }
        }
    }

    private async Task CloseAsync()
    {
        _open = false;
        if (_pingHeld)
        {
            PingLive.Release();
            _pingHeld = false;
        }
        await Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        if (_pingHeld)
            PingLive.Release();
        return ValueTask.CompletedTask;
    }
}
