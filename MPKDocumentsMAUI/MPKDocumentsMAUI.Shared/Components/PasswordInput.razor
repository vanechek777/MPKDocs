@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="password-input-wrap @WrapClass">
    <input @ref="_inputRef"
           class="@CssClass password-input-field"
           type="password"
           autocomplete="@Autocomplete"
           placeholder="@Placeholder"
           maxlength="@MaxLength"
           disabled="@Disabled"
           value="@Value"
           @oninput="OnInput" />
    @if (_capsLock || _rusLayout)
    {
        <div class="password-input-hints" aria-hidden="true">
            @if (_capsLock)
            {
                <img src="icons/upper.png" alt="" class="password-input-hint" title="Включён Caps Lock" />
            }
            @if (_rusLayout)
            {
                <img src="icons/rusLang.png" alt="" class="password-input-hint" title="Русская раскладка" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string CssClass { get; set; } = "form-input";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _inputRef;
    private bool _capsLock;
    private bool _rusLayout;
    private DotNetObjectReference<PasswordInput>? _dotNetRef;
    private bool _wired;

    private string WrapClass => (_capsLock, _rusLayout) switch
    {
        (true, true) => "password-input-wrap--two-hints",
        (true, false) => "password-input-wrap--one-hint",
        (false, true) => "password-input-wrap--one-hint",
        _ => ""
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _wired)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("MPKDocuments.wirePasswordInput", _inputRef, _dotNetRef);
            _wired = true;
        }
        catch
        {
            /* WebView без JS */
        }
    }

    [JSInvokable]
    public void OnPasswordInputHints(bool capsLock, bool? russianLayout)
    {
        var changed = _capsLock != capsLock;
        if (russianLayout.HasValue && _rusLayout != russianLayout.Value)
            changed = true;

        _capsLock = capsLock;
        if (russianLayout.HasValue)
            _rusLayout = russianLayout.Value;

        if (changed)
            _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    public async ValueTask DisposeAsync()
    {
        if (_wired)
        {
            try
            {
                await JS.InvokeVoidAsync("MPKDocuments.unwirePasswordInput", _inputRef);
            }
            catch
            {
                /* ignore */
            }
        }

        _dotNetRef?.Dispose();
    }
}
