@inject IJSRuntime JS

@if (IsOpen && Result is { UpdateAvailable: true } update)
{
    <div class="modal-overlay" @onclick="DismissUnlessMandatory">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">Доступно обновление</div>
            <div class="modal-body">
                <p style="margin:0 0 12px">
                    У вас <strong>@AppVersionInfo.FullLabel</strong>.
                    @if (update.Release?.Version is { } ver && update.Release.Build is { } build)
                    {
                        @if (string.Equals(ver, AppVersionInfo.DisplayVersion, StringComparison.OrdinalIgnoreCase)
                             && build == AppVersionInfo.Build)
                        {
                            <text>На сервере та же версия, но требуется переустановка.</text>
                        }
                        else
                        {
                            <text>Доступна <strong>@ver (@build)</strong>.</text>
                        }
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(update.Release?.Notes))
                {
                    <p class="admin-hint" style="margin:0 0 12px; white-space:pre-wrap">@update.Release.Notes</p>
                }
                @if (string.IsNullOrWhiteSpace(update.DownloadUrl))
                {
                    <p class="admin-hint admin-hint--bad" style="margin:0">Ссылка на скачивание не настроена на сервере.</p>
                }
                else if (update.Mandatory)
                {
                    <p class="admin-hint" style="margin:0">Обновление обязательно для продолжения работы.</p>
                }
            </div>
            <div class="modal-footer" style="display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap">
                @if (!update.Mandatory)
                {
                    <button type="button" class="btn btn-secondary" @onclick="DismissAsync">Позже</button>
                }
                <button type="button" class="btn btn-green" disabled="@(string.IsNullOrWhiteSpace(update.DownloadUrl) || _busy)" @onclick="DownloadAsync">
                    Скачать обновление
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public AppUpdateCheckResult? Result { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool _busy;

    private async Task DownloadAsync()
    {
        if (Result?.DownloadUrl is not { } url)
            return;

        _busy = true;
        try
        {
            await JS.InvokeVoidAsync("MPKDocuments.openExternalUrl", url);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DismissAsync()
    {
        if (OnDismiss.HasDelegate)
            await OnDismiss.InvokeAsync();
    }

    private void DismissUnlessMandatory()
    {
        if (Result?.Mandatory == true)
            return;
        _ = DismissAsync();
    }
}
