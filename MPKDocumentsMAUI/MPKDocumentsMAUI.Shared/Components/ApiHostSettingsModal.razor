@inject IApiPingLiveService PingLive
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="modal-overlay auth-api-settings-overlay" @onclick="CloseAsync">
        <div class="modal-card auth-api-settings-modal" @onclick:stopPropagation="true">
            <div class="modal-header">@Title</div>
            <div class="modal-body">
                @if (ShowThemeToggle)
                {
                    <div class="auth-settings-section">
                        <div class="auth-settings-section-title">Оформление</div>
                        <DarkThemeToggle />
                    </div>
                }

                <div class="auth-settings-section">
                    <div class="auth-settings-section-title">Подключение к серверу</div>
                    @if (!string.IsNullOrWhiteSpace(Intro))
                    {
                        <p class="auth-api-settings-intro">@Intro</p>
                    }
                    <ApiEndpointSettings AllowManageEndpoints="@AllowManageEndpoints" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Готово</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool AllowManageEndpoints { get; set; }
    [Parameter] public bool ShowThemeToggle { get; set; }
    [Parameter] public string Title { get; set; } = "Настройки";
    [Parameter] public string? Intro { get; set; } =
        "Выберите адрес API, через который приложение входит и загружает документы.";

    private bool _pingHeld;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_pingHeld)
        {
            PingLive.Acquire();
            _pingHeld = true;
            try
            {
                await PingLive.RefreshNowAsync();
            }
            catch
            {
                /* сеть */
            }
        }
        else if (!IsOpen && _pingHeld)
        {
            PingLive.Release();
            _pingHeld = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_pingHeld)
        {
            PingLive.Release();
            _pingHeld = false;
        }

        if (IsOpenChanged.HasDelegate)
            await IsOpenChanged.InvokeAsync(false);
    }

    public ValueTask DisposeAsync()
    {
        if (_pingHeld)
            PingLive.Release();
        return ValueTask.CompletedTask;
    }
}
