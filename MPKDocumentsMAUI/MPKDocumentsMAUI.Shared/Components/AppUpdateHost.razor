@inject IAppUpdateService Updates
@implements IDisposable

<AppUpdateModal IsOpen="Updates.PromptVisible"
                Result="Updates.LastResult"
                OnDismiss="DismissAsync" />

@code {
    private bool _checked;

    protected override void OnInitialized()
    {
        Updates.Changed += OnUpdatesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked)
            return;

        _checked = true;
        await Updates.CheckForUpdatesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnUpdatesChanged() => _ = InvokeAsync(StateHasChanged);

    private Task DismissAsync()
    {
        Updates.DismissCurrentOffer();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Updates.Changed -= OnUpdatesChanged;
    }
}
