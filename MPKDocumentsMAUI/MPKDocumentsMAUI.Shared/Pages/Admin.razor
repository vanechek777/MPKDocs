@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Navigation
@inject MPKDocumentsMAUI.Shared.Auth.AuthService Auth
@inject MPKDocumentsMAUI.Shared.Api.IApiEndpointStore ApiEndpoints
@implements IAsyncDisposable
@inject MPKDocumentsMAUI.Shared.Api.AdminApiClient AdminApi
@inject IApiPingLiveService PingLive
@inject MPKDocumentsMAUI.Shared.Services.IFileDownloadService FileDownload
@inject StaffRegisterApiClient StaffApi
@inject MPKDocumentsMAUI.Shared.Services.IDocumentFilePicker DocumentFilePicker
@inject MPKDocumentsMAUI.Shared.Services.IReleaseBuildService ReleaseBuild
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using MPKDocumentsMAUI.Shared.Services

<PageTitle>Админ-панель — @AppBranding.DisplayName</PageTitle>

<div class="page-content admin-page">
    <h1 class="page-title">Админ-панель</h1>

    @if (_loading)
    {
        <div class="mpk-page-loading"><LoadingSpinner Center /></div>
    }
    else if (!_isAdmin)
    {
        <div class="profile-section">
            <p class="admin-muted">У этой учётной записи нет прав администратора.</p>
            <p class="admin-hint">Админ назначается в БД: <code>Users.IsAdmin = 1</code> (после миграции для <strong>+79148012594</strong> выставлено в сидере) или переменная <code>MPK_ADMIN_USER_IDS</code> (id через запятую).</p>
            <button type="button" class="btn btn-secondary" style="margin-top:var(--spacing-xl)" @onclick="GoProfile">К профилю</button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-error admin-banner">@_error</div>
        }

        <div class="admin-toolbar">
            <button type="button" class="btn btn-green" disabled="@_busy" @onclick="RefreshAllAsync">Обновить данные</button>
            <button type="button" class="btn btn-outline" disabled="@_busy" @onclick="PingAsync">Пинг API</button>
            <a class="settings-link admin-docs-link" href="@_apiDocsUrl" target="_blank" rel="noopener noreferrer">OpenAPI (Swagger)</a>
        </div>

        <div class="admin-stats">
            <div class="admin-stat @( _dash?.DatabaseOk == true ? "admin-stat--ok" : "admin-stat--bad")">
                <div class="admin-stat-label">База данных</div>
                <div class="admin-stat-value">@(_dash?.DatabaseOk == true ? "OK" : "Ошибка")</div>
                @if (_dash?.DatabaseLatencyMs is { } ms)
                {
                    <div class="admin-stat-sub">запрос SELECT 1: @ms.ToString("0.0") мс</div>
                }
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Клиент → /health</div>
                <div class="admin-stat-value">@FormatActivePingMs()</div>
                <div class="admin-stat-sub">без авторизации · обновление каждые 2 с</div>
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Время на сервере (UTC)</div>
                <div class="admin-stat-value admin-stat-value--sm">@(_dash?.ServerTimeUtc ?? "—")</div>
                <div class="admin-stat-sub">версия API @(_dash?.AppVersion ?? "—")</div>
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Онлайн (~5 мин)</div>
                <div class="admin-stat-value">@(_dash?.OnlineUsers5m.ToString() ?? "—")</div>
                <div class="admin-stat-sub">по последним запросам с JWT</div>
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Пользователей</div>
                <div class="admin-stat-value">@(_dash?.UsersTotal.ToString() ?? "—")</div>
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Документов</div>
                <div class="admin-stat-value">@(_dash?.DocumentsTotal.ToString() ?? "—")</div>
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Активных шаблонов</div>
                <div class="admin-stat-value">@(_dash?.TemplatesActive.ToString() ?? "—")</div>
            </div>
            <div class="admin-stat">
                <div class="admin-stat-label">Категорий</div>
                <div class="admin-stat-value">@(_dash?.CategoriesTotal.ToString() ?? "—")</div>
            </div>
        </div>

        <div class="profile-section admin-section">
            <div class="admin-section-head">
                <div class="profile-section-title" style="margin:0">Журнал действий</div>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="OpenActivityModalAsync">
                    Все операции…
                </button>
            </div>
            <p class="admin-hint">На странице — последние @_activityPreviewLimit записей. Полный список (до @_activityModalLimit) и выгрузка в .txt — в отдельном окне.</p>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>Время</th>
                        <th>Пользователь</th>
                        <th>Действие</th>
                        <th>Детали</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (_activityPreview.Count == 0)
                    {
                        <tr><td colspan="4" class="admin-muted">Записей пока нет.</td></tr>
                    }
                    @foreach (var a in _activityPreview)
                    {
                        <tr>
                            <td class="admin-nowrap">@FormatActivityTime(a.CreatedAt)</td>
                            <td>@(string.IsNullOrEmpty(a.UserName) ? (a.UserId?.ToString() ?? "—") : a.UserName)</td>
                            <td><code class="admin-code">@a.Action</code></td>
                            <td class="admin-detail">@(a.Detail ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="profile-section admin-section">
            <div class="profile-section-title">Администраторы</div>
            <p class="admin-hint">Назначить по номеру телефона (пользователь уже должен быть зарегистрирован).</p>
            <div class="admin-inline-form">
                <input class="form-input" placeholder="+79990000000" @bind="_promotePhone" />
                <button type="button" class="btn btn-green" disabled="@_busy" @onclick="PromoteByPhoneAsync">Сделать админом</button>
            </div>
            <div class="admin-table-wrap" style="margin-top:var(--spacing-lg)">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>ФИО</th>
                        <th>Телефон</th>
                        <th>Админ</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in _users.OrderByDescending(x => x.IsAdmin))
                    {
                        <tr>
                            <td>@u.FullName</td>
                            <td class="admin-nowrap">@u.PhoneNumber</td>
                            <td>
                                <label class="toggle-switch" style="vertical-align:middle">
                                    <input type="checkbox" checked="@u.IsAdmin" disabled="@_busy"
                                           @onchange="e => ToggleAdminAsync(u, ParseCheckbox(e))" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="profile-section admin-section">
            <div class="profile-section-title">Категории документов</div>
            <p class="admin-hint">Категория — только группа в мастере «Создать документ». Чтобы появился конкретный тип файла, в блоке ниже добавьте <strong>тип (шаблон)</strong> и привяжите к категории.</p>
            <div class="admin-inline-form">
                <input class="form-input" placeholder="Название категории" @bind="_newCategoryName" />
                <button type="button" class="btn btn-green" disabled="@_busy" @onclick="AddCategoryAsync">Добавить</button>
            </div>
            <div class="admin-table-wrap" style="margin-top:var(--spacing-lg)">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>Название</th>
                        <th>Порядок</th>
                        <th>Активна</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in _categories.OrderBy(x => x.SortOrder))
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@c.SortOrder</td>
                            <td>
                                <label class="toggle-switch">
                                    <input type="checkbox" checked="@(c.IsActive != false)" disabled="@_busy"
                                           @onchange="e => PatchCategoryActiveAsync(c.Id, ParseCheckbox(e))" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="profile-section admin-section">
            <div class="profile-section-title">Типы документов (шаблоны)</div>
            <p class="admin-hint">Минимальная запись для списка в приложении. Путь к .docx можно поправить позже в БД.</p>
            <div class="admin-inline-form admin-inline-form--wrap">
                <input class="form-input" style="min-width:200px" placeholder="Название типа" @bind="_newTemplateName" />
                <select class="form-input" style="max-width:220px" @bind="_newTemplateCategoryId">
                    <option value="">Без категории</option>
                    @foreach (var c in _categories.Where(x => x.IsActive != false))
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <button type="button" class="btn btn-green" disabled="@_busy" @onclick="AddTemplateAsync">Добавить тип</button>
            </div>
            <div class="admin-table-wrap" style="margin-top:var(--spacing-lg)">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Путь</th>
                        <th>Активен</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in _templates)
                    {
                        <tr>
                            <td>@t.Name</td>
                            <td>@(t.CategoryName ?? "—")</td>
                            <td class="admin-detail" title="@t.TemplatePath">@AbbrevPath(t.TemplatePath)</td>
                            <td>
                                <label class="toggle-switch">
                                    <input type="checkbox" checked="@(t.IsActive != false)" disabled="@_busy"
                                           @onchange="e => PatchTemplateActiveAsync(t.Id, ParseCheckbox(e))" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="profile-section admin-section">
            <div class="profile-section-title">Кадровый справочник (1С / Excel)</div>
            <p class="admin-hint">
                Записи справочника используются при регистрации: ФИО, должность и отдел должны совпадать с импортом.
                Сейчас в справочнике: <strong>@_staffStats?.StaffTotal.ToString() ?? "—"</strong> сотрудников.
            </p>

            <div class="admin-onec-wizard">
                <div class="admin-section-subtitle">Мастер подключения 1С</div>
                <div class="admin-inline-form admin-inline-form--wrap">
                    <InputText class="form-input" placeholder="https://1c.company.local/odata" @bind-Value="_onecBaseUrl" />
                    <InputText class="form-input" placeholder="Логин" @bind-Value="_onecUsername" />
                    <PasswordInput @bind-Value="_onecPassword" Placeholder="Пароль (оставьте пустым, чтобы не менять)" Autocomplete="new-password" />
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_staffBusy" @onclick="SaveOneCConfigAsync">Сохранить</button>
                    <button type="button" class="btn btn-outline btn-sm" disabled="@_staffBusy" @onclick="TestOneCAsync">Проверить</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_onecTestMessage))
                {
                    <p class="admin-hint @(_onecTestOk ? "admin-hint--ok" : "admin-hint--bad")">@_onecTestMessage</p>
                }
            </div>

            <div class="admin-import-row">
                <div class="admin-section-subtitle">Импорт из Excel / CSV</div>
                <p class="admin-hint">Колонки: <strong>ФИО</strong>, <strong>Должность</strong>, <strong>Отдел</strong> (первая строка — заголовки).</p>
                <InputFile OnChange="OnStaffFileSelected" accept=".csv,.xlsx,.xlsm" disabled="@_staffBusy" />
                @if (!string.IsNullOrWhiteSpace(_staffImportMessage))
                {
                    <p class="admin-hint">@_staffImportMessage</p>
                }
            </div>
        </div>

        <div class="profile-section admin-section">
            <div class="admin-section-head">
                <div>
                    <div class="profile-section-title" style="margin:0">Публикация версии</div>
                    <p class="admin-hint" style="margin:6px 0 0;padding:0">
                        На Windows с исходниками — встроенный сборщик ниже. Иначе загрузите готовый .exe вручную.
                    </p>
                </div>
                @if (_relConfigured)
                {
                    <span class="admin-release-live-badge">v@_relPublishedVersion · build @_relPublishedBuild</span>
                }
            </div>

            <div class="admin-release-card">
                <div class="admin-release-segment" role="radiogroup" aria-label="Платформа">
                    @foreach (var p in ReleasePlatforms)
                    {
                        var active = string.Equals(_relPlatform, p.Key, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="admin-release-segment-btn @(active ? "admin-release-segment-btn--active" : null)"
                                disabled="@_relPublishBusy"
                                @onclick="() => SelectReleasePlatform(p.Key)">
                            @p.Short
                        </button>
                    }
                </div>

                <div class="admin-release-fields">
                    <div class="admin-release-field">
                        <label class="form-label">Версия</label>
                        <input class="form-input" placeholder="1.0.1" @bind="_relVersion" disabled="@_relPublishBusy" />
                    </div>
                    <div class="admin-release-field admin-release-field--narrow">
                        <label class="form-label">Сборка</label>
                        <input class="form-input" type="number" min="1" @bind="_relBuild" disabled="@_relPublishBusy" />
                    </div>
                    <div class="admin-release-field admin-release-field--action">
                        <label class="form-label" aria-hidden="true">&nbsp;</label>
                        <button type="button" class="btn btn-outline btn-sm admin-release-suggest-btn" disabled="@(_relPublishBusy || _buildBusy)" @onclick="SuggestReleaseAsync">
                            Следующая
                        </button>
                    </div>
                </div>

                <div class="admin-release-options">
                    <label class="admin-release-toggle">
                        <input type="checkbox" @bind="_relMandatory" disabled="@_relPublishBusy" />
                        <span>Обязательное обновление</span>
                    </label>
                    <button type="button" class="admin-release-advanced-link" @onclick="() => _relShowAdvanced = !_relShowAdvanced">
                        @(_relShowAdvanced ? "Скрыть дополнительно" : "Дополнительно")
                    </button>
                </div>

                @if (_relShowAdvanced)
                {
                    <div class="admin-release-field admin-release-field--narrow" style="margin-top:4px">
                        <label class="form-label">Мин. сборка клиента</label>
                        <input class="form-input" type="number" min="0" @bind="_relMinBuild" disabled="@_relPublishBusy" />
                    </div>
                }

                <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Что нового</label>
                    <textarea class="form-textarea admin-release-notes" rows="3" @bind="_relNotes" placeholder="Исправления, новые функции…" disabled="@(_relPublishBusy || _buildBusy)"></textarea>
                </div>

                @if (ReleaseBuild.IsAvailable && string.Equals(_relPlatform, "windows", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="admin-release-builder">
                        <div class="admin-release-builder-head">
                            <span class="admin-release-builder-title">Сборщик Windows</span>
                            @if (_localProject is not null)
                            {
                                <span class="admin-hint" style="margin:0;padding:0">
                                    csproj: v@_localProject.Version (@_localProject.Build)
                                </span>
                            }
                        </div>
                        <p class="admin-hint" style="margin:0;padding:0">
                            Обновит <code>.csproj</code>, соберёт установщик (нужны .NET SDK и Inno Setup 6).
                        </p>
                        @if (!string.IsNullOrWhiteSpace(_buildLog))
                        {
                            <pre class="admin-build-log">@_buildLog</pre>
                        }
                        <div class="admin-release-actions">
                            <button type="button"
                                    class="btn btn-green admin-release-publish-btn"
                                    disabled="@(_buildBusy || _relPublishBusy || string.IsNullOrWhiteSpace(_relVersion) || _relBuild < 1)"
                                    @onclick="() => RunReleaseBuildAsync(publishAfter: true)">
                                @if (_buildBusy)
                                {
                                    <span class="mpk-btn-loading"><span class="mpk-spinner mpk-spinner--sm" aria-hidden="true"></span><span>Собираем…</span></span>
                                }
                                else
                                {
                                    <span>Собрать и опубликовать</span>
                                }
                            </button>
                            <button type="button"
                                    class="admin-release-secondary-link"
                                    disabled="@(_buildBusy || _relPublishBusy)"
                                    @onclick="() => RunReleaseBuildAsync(publishAfter: false)">
                                Собрать и сохранить как…
                            </button>
                        </div>
                    </div>
                }

                @if (DocumentFilePicker.SupportsNativePick)
                {
                    <button type="button"
                            class="admin-release-file-zone @(_relPendingFileBytes is not null ? "admin-release-file-zone--selected" : null)"
                            disabled="@_relPublishBusy"
                            @onclick="PickReleaseFileNativeAsync">
                        <span class="admin-release-file-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/>
                                <line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                        </span>
                        <span class="admin-release-file-text">
                            @if (!string.IsNullOrWhiteSpace(_relSelectedFileName))
                            {
                                <span class="admin-release-file-title">@_relSelectedFileName</span>
                                <span class="admin-release-file-sub">Нажмите, чтобы выбрать другой файл</span>
                            }
                            else
                            {
                                <span class="admin-release-file-title">Выберите файл @GetReleaseFileKind()</span>
                                <span class="admin-release-file-sub">@GetReleasePlatformHint()</span>
                            }
                        </span>
                    </button>
                }
                else
                {
                    <div class="admin-release-file-zone @(_relPendingFileBytes is not null ? "admin-release-file-zone--selected" : null)">
                        <span class="admin-release-file-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/>
                                <line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                        </span>
                        <span class="admin-release-file-text">
                            @if (!string.IsNullOrWhiteSpace(_relSelectedFileName))
                            {
                                <span class="admin-release-file-title">@_relSelectedFileName</span>
                                <span class="admin-release-file-sub">@GetReleasePlatformHint()</span>
                            }
                            else
                            {
                                <span class="admin-release-file-title">@GetReleasePlatformHint()</span>
                            }
                            <InputFile class="mpk-inputfile" style="margin-top:8px"
                                       OnChange="OnReleaseFileSelected"
                                       accept="@GetReleaseAccept()"
                                       disabled="@_relPublishBusy" />
                        </span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_relMessage))
                {
                    <div class="admin-release-banner @(_relMessageOk ? "admin-release-banner--ok" : "admin-release-banner--bad")">
                        @_relMessage
                    </div>
                }

                <div class="admin-release-actions">
                    <button type="button" class="btn btn-green admin-release-publish-btn" disabled="@(_relPublishBusy || _relPendingFileBytes is null)" @onclick="PublishReleaseAsync">
                        @if (_relPublishBusy)
                        {
                            <span class="mpk-btn-loading"><span class="mpk-spinner mpk-spinner--sm" aria-hidden="true"></span><span>Публикуем…</span></span>
                        }
                        else
                        {
                            <span>Опубликовать для @GetPlatformTitle()</span>
                        }
                    </button>
                    <button type="button" class="admin-release-secondary-link" disabled="@_relPublishBusy" @onclick="SaveAppReleaseAsync">
                        Сохранить только номер версии (без файла)
                    </button>
                </div>
            </div>

            @if (HasActiveReleaseLinks())
            {
                <div class="admin-release-links">
                    <div class="admin-section-subtitle">Сейчас на сервере</div>
                    <div class="profile-info-list">
                        @if (!string.IsNullOrWhiteSpace(_relWindowsUrl))
                        {
                            <a class="admin-release-link-item" href="@_relWindowsUrl" target="_blank" rel="noopener">
                                <span>Windows</span>
                                <span class="admin-release-link-arrow">↗</span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_relAndroidUrl))
                        {
                            <a class="admin-release-link-item" href="@_relAndroidUrl" target="_blank" rel="noopener">
                                <span>Android</span>
                                <span class="admin-release-link-arrow">↗</span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_relIosUrl))
                        {
                            <a class="admin-release-link-item" href="@_relIosUrl" target="_blank" rel="noopener">
                                <span>iOS</span>
                                <span class="admin-release-link-arrow">↗</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (_relFiles.Count > 0)
            {
                <div class="admin-release-links" style="margin-top:12px">
                    <div class="admin-section-subtitle">Загруженные файлы</div>
                    <div class="profile-info-list">
                        @foreach (var f in _relFiles.Take(6))
                        {
                            <div class="admin-release-file-row">
                                <code class="admin-release-file-name">@f.Name</code>
                                <span class="admin-release-file-size">@FormatFileSize(f.SizeBytes)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div id="api-hosts" class="profile-section admin-section">
            <div class="profile-section-title">Базовый URL API (клиент)</div>
            <ApiEndpointSettings AllowManageEndpoints="true" />
        </div>
    }
</div>

@if (_showActivityModal)
{
    <div class="modal-overlay" @onclick="CloseActivityModal">
        <div class="modal-card admin-activity-modal" @onclick:stopPropagation="true">
            <div class="modal-header">Журнал действий</div>
            <div class="modal-body">
                <p class="admin-hint" style="padding-top:0;margin-top:0">
                    До @_activityModalLimit последних операций. Для выгрузки укажите период (необязательно) и нажмите «Скачать .txt».
                </p>
                <div class="admin-activity-export-row">
                    <label class="admin-activity-date-label">
                        <span>С</span>
                        <input type="date" class="form-input" @bind="_exportFrom" disabled="@_activityModalBusy" />
                    </label>
                    <label class="admin-activity-date-label">
                        <span>По</span>
                        <input type="date" class="form-input" @bind="_exportTo" disabled="@_activityModalBusy" />
                    </label>
                    <button type="button" class="btn btn-green btn-sm" disabled="@_activityModalBusy" @onclick="ExportActivityTxtAsync">
                        Скачать .txt
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_activityModalBusy" @onclick="ReloadActivityModalAsync">
                        Обновить список
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_activityModalError))
                {
                    <p class="admin-activity-modal-error">@_activityModalError</p>
                }
                @if (_activityModalBusy)
                {
                    <div class="verify-nep-busy" style="margin:12px 0"><LoadingSpinner Size="sm" Caption="Загрузка…" /></div>
                }
                <div class="admin-table-wrap admin-activity-modal-table">
                    <table class="admin-table">
                        <thead>
                        <tr>
                            <th>Время</th>
                            <th>Пользователь</th>
                            <th>Действие</th>
                            <th>Детали</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (!_activityModalBusy && _activityModal.Count == 0)
                        {
                            <tr><td colspan="4" class="admin-muted">Нет записей за выбранные условия.</td></tr>
                        }
                        @foreach (var a in _activityModal)
                        {
                            <tr>
                                <td class="admin-nowrap">@FormatActivityTime(a.CreatedAt)</td>
                                <td>@(string.IsNullOrEmpty(a.UserName) ? (a.UserId?.ToString() ?? "—") : a.UserName)</td>
                                <td><code class="admin-code">@a.Action</code></td>
                                <td class="admin-detail">@(a.Detail ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (_activityModal.Count >= _activityModalLimit)
                {
                    <p class="admin-hint">Показаны первые @_activityModalLimit записей (самые новые). Сузьте период при выгрузке.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" disabled="@_activityModalBusy" @onclick="CloseActivityModal">Закрыть</button>
            </div>
        </div>
    </div>
}

