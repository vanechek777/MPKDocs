        _relPublishBusy = true;
        _relMessage = null;
        try
        {
            await using var ms = new MemoryStream(_relPendingFileBytes);

            var result = await AdminApi.PublishAppReleaseAsync(
                ms,
                _relSelectedFileName,
                _relVersion.Trim(),
                _relBuild,
                _relPlatform,
                _relMinBuild,
                _relMandatory,
                string.IsNullOrWhiteSpace(_relNotes) ? null : _relNotes.Trim());

            _relConfigured = true;
