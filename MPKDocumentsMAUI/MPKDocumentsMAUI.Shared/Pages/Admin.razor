            _relWindowsUrl = result.WindowsUrl ?? "";
            _relAndroidUrl = result.AndroidUrl ?? "";
            _relIosUrl = result.IosUrl ?? "";
            _relWebUrl = result.WebUrl ?? "";
            _relFiles = result.ReleaseFiles?.ToList() ?? _relFiles;
            _relPendingFileBytes = null;
            _relSelectedFileName = null;
            _relMessage =
