    private async Task RunReleaseBuildAsync(bool publishAfter)
    {
        if (_buildBusy || _relPublishBusy) return;
        if (string.IsNullOrWhiteSpace(_relVersion) || _relBuild < 1)
        {
            _relMessage = "Укажите версию и сборку.";
            _relMessageOk = false;
            return;
        }

        _buildBusy = true;
        _buildLog = "";
        _relMessage = null;
        try
        {
            var progress = new Progress<string>(line =>
            {
                _buildLog = string.IsNullOrEmpty(_buildLog) ? line : _buildLog + "\n" + line;
                _ = InvokeAsync(StateHasChanged);
            });

            var result = await ReleaseBuild.BuildInstallerAsync(
                _relVersion.Trim(),
                _relBuild,
                progress);

            if (!result.Ok)
            {
                _relMessage = result.Error ?? "Сборка не удалась.";
                _relMessageOk = false;
                return;
            }

            _localProject = await ReleaseBuild.TryDetectLocalProjectAsync();

            if (publishAfter)
            {
                _relPendingFileBytes = result.InstallerBytes;
                _relSelectedFileName = result.InstallerFileName;
                _relPlatform = "windows";
                await PublishReleaseAsync();
                return;
            }

            if (result.InstallerBytes is null || string.IsNullOrWhiteSpace(result.InstallerFileName))
            {
                _relMessage = "Сборка завершена, но файл пуст.";
                _relMessageOk = false;
                return;
            }

            var saved = await FileDownload.TrySaveFileAsync(
                result.InstallerFileName,
                result.InstallerBytes,
                "application/octet-stream");

            _relMessage = saved
                ? $"Установщик v{result.BuiltVersion} (build {result.BuiltBuild}) сохранён."
                : "Сборка готова. Сохранение отменено.";
            _relMessageOk = saved;
        }
        catch (Exception ex)
        {
            _relMessage = ex.Message;
            _relMessageOk = false;
        }
        finally
        {
            _buildBusy = false;
        }
    }

