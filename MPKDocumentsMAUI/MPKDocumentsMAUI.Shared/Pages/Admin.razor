    private async Task PickReleaseFileNativeAsync()
    {
        if (_relPublishBusy) return;
        _relMessage = null;
        try
        {
            const int maxBytes = 200 * 1024 * 1024;
            var info = await DocumentFilePicker.PickFileAsync(
                GetReleaseExtensions(),
                $"Выберите файл {GetReleaseFileKind()}");
            if (info is null)
            {
                _relPendingFileBytes = null;
                _relSelectedFileName = null;
                return;
            }

            _relSelectedFileName = info.FileName;
            _relPendingFileBytes = await DocumentFilePicker.TryReadLastNativePickAsync(maxBytes);
            if (_relPendingFileBytes is null)
            {
                _relMessage = $"Файл слишком большой (макс. {maxBytes / (1024 * 1024)} МБ).";
                _relMessageOk = false;
                _relSelectedFileName = null;
            }
        }
        catch (Exception ex)
        {
            _relPendingFileBytes = null;
            _relSelectedFileName = null;
            _relMessage = ex.Message;
            _relMessageOk = false;
        }
