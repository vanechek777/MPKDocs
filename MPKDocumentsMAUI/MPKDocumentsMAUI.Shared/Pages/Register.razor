@page "/register"
@layout MPKDocumentsMAUI.Shared.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject MPKDocumentsMAUI.Shared.Auth.AuthService Auth
@inject MPKDocumentsMAUI.Shared.Services.IMobileShellService MobileShell
@inject StaffRegisterApiClient StaffApi

<div class="auth-page">
    <div class="auth-card auth-card--register">
        <div class="auth-brand">
            <div>
                <h2 class="auth-title">Регистрация</h2>
                <div class="auth-subtitle">@AppBranding.DisplayName — подтверждение почты кодом</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="auth-error">@_error</div>
        }

        @if (_step == RegisterStep.Form)
        {
            <EditForm Model="_model" OnValidSubmit="SendCodeFromFormAsync">
                <DataAnnotationsValidator />

                <div class="register-form-grid">
                    <div class="register-staff-warning">
                        Должность и отдел указываются один раз при регистрации. После создания аккаунта изменить их будет нельзя.
                    </div>

                    <div class="register-form-col">
                        <div class="form-group staff-autocomplete">
                            <label class="form-label">ФИО</label>
                            <input class="form-input" value="@_model.FullName"
                                   @oninput="OnFullNameInput"
                                   placeholder="Иванов Иван Иванович"
                                   autocomplete="name" />
                            @if (_suggestions.Count > 0)
                            {
                                <ul class="staff-suggestions" role="listbox">
                                    @foreach (var s in _suggestions)
                                    {
                                        <li role="option" @onclick="() => SelectSuggestionAsync(s)">
                                            <span class="staff-suggestions__name">@s.full_name</span>
                                            <span class="staff-suggestions__meta">@s.position_name · @s.department_name</span>
                                        </li>
                                    }
                                </ul>
                            }
                            <ValidationMessage For="() => _model.FullName" />
                            <div class="form-hint-muted">Начните вводить ФИО — появятся варианты из кадрового справочника.</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Должность</label>
                            <InputSelect class="form-input" TValue="int" @bind-Value="_model.PositionId" @bind-Value:after="OnPositionChangedAsync">
                                <option value="0">— выберите должность —</option>
                                @foreach (var p in _positions)
                                {
                                    <option value="@p.id">@p.name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="form-group register-form-col__last">
                            <label class="form-label">Отдел</label>
                            <InputSelect class="form-input" TValue="int" @bind-Value="_model.DepartmentId" disabled="@(_model.PositionId <= 0)">
                                <option value="0">— выберите отдел —</option>
                                @foreach (var d in _departments)
                                {
                                    <option value="@d.id">@d.name</option>
                                }
                            </InputSelect>
                            <div class="form-hint-muted">Список отделов зависит от выбранной должности.</div>
                        </div>
                    </div>

                    <div class="register-form-col">
                        <div class="form-group">
                            <label class="form-label">Телефон</label>
                            <PhoneInput @bind-Value="_model.PhoneNumber" />
                            <ValidationMessage For="() => _model.PhoneNumber" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <InputText class="form-input" @bind-Value="_model.Email" type="email" autocomplete="email" placeholder="user@yandex.ru" />
                            <ValidationMessage For="() => _model.Email" />
                            <div class="form-hint-muted">На этот адрес придёт код для завершения регистрации.</div>
                        </div>

                        <div class="form-group register-form-col__last">
                            <label class="form-label">Пароль</label>
                            <PasswordInput @bind-Value="_model.Password" Autocomplete="new-password" />
                            <ValidationMessage For="() => _model.Password" />
                        </div>
                    </div>

                    <div class="auth-actions register-form-grid__actions">
                    <button class="btn btn-green" disabled="@_busy" type="submit">
                        @if (_busy)
                        {
                            <span class="mpk-btn-loading"><span class="mpk-spinner mpk-spinner--sm" aria-hidden="true"></span><span>Отправляем код…</span></span>
                        }
                        else
                        {
                            <span>Отправить код на почту</span>
                        }
                    </button>
                    <button class="btn btn-outline" type="button" @onclick="GoLogin">
                        Уже есть аккаунт? Войти
                    </button>
                    </div>
                </div>
            </EditForm>
        }
        else
        {
            <div class="form-group">
                <label class="form-label">Код из письма</label>
                <InputText class="form-input mpk-email-code-field" maxlength="12" inputmode="numeric" autocomplete="one-time-code"
                           @bind-Value="_code" placeholder="######" />
                <div class="form-hint-muted">
                    Адрес: <strong>@_model.Email.Trim()</strong>
                    · <button type="button" class="auth-inline-link" @onclick="BackToFormAsync">Изменить данные</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_lastDevRegisterCode))
            {
                <div class="auth-dev-hint">Тест-сервер: код <strong>@_lastDevRegisterCode</strong></div>
            }

            <div class="auth-actions auth-actions-row">
                <button class="btn btn-outline" disabled="@_busyVerify" type="button" @onclick="ResendRegisterCodeAsync">Код ещё раз</button>
                <button class="btn btn-green" disabled="@(_busyVerify || string.IsNullOrWhiteSpace(_code))" type="button" @onclick="VerifyRegisterAsync">
                    @if (_busyVerify)
                    {
                        <span class="mpk-btn-loading"><span class="mpk-spinner mpk-spinner--sm" aria-hidden="true"></span><span>Создаём…</span></span>
                    }
                    else
                    {
                        <span>Подтвердить регистрацию</span>
                    }
                </button>
            </div>

            <div class="auth-secondary-link">
                <button type="button" class="auth-inline-link" @onclick="GoLogin">Уже есть аккаунт? Войти</button>
            </div>
        }
    </div>
</div>

@code {
    private enum RegisterStep { Form, Code }

    private RegisterStep _step = RegisterStep.Form;
    private bool _busy;
    private bool _busyVerify;
    private string? _error;
    private string _code = "";
    private string? _lastDevRegisterCode;

    private RegisterModel _model = new();
    private List<StaffSuggestItem> _suggestions = new();
    private List<StaffPositionItem> _positions = new();
    private List<StaffDepartmentItem> _departments = new();
    private CancellationTokenSource? _suggestCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _positions = await StaffApi.GetPositionsAsync();
        }
        catch
        {
            _positions = new();
        }
    }

    private async Task OnPositionChangedAsync()
    {
        _model.DepartmentId = 0;
        await LoadDepartmentsAsync();
    }

    private async Task LoadDepartmentsAsync()
    {
        if (_model.PositionId <= 0)
        {
            _departments = new();
            return;
        }

        try
        {
            _departments = await StaffApi.GetDepartmentsForPositionAsync(_model.PositionId);
        }
        catch
        {
            _departments = new();
        }
    }

    private async Task SelectSuggestionAsync(StaffSuggestItem s)
    {
        _model.FullName = s.full_name;
        _model.PositionId = s.position_id;
        _model.DepartmentId = s.department_id;
        _suggestions.Clear();
        await LoadDepartmentsAsync();
    }

    private async Task OnFullNameInput(ChangeEventArgs e)
    {
        _model.FullName = e.Value?.ToString() ?? "";
        _suggestCts?.Cancel();
        _suggestCts = new CancellationTokenSource();
        var ct = _suggestCts.Token;
        var q = _model.FullName.Trim();
        if (q.Length < 2)
        {
            _suggestions.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            await Task.Delay(250, ct);
            _suggestions = await StaffApi.SuggestNamesAsync(q, 10, ct);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            _suggestions.Clear();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendCodeFromFormAsync()
    {
        if (_busy) return;
        _error = null;

        if (!PhoneDisplay.IsCompleteRu(_model.PhoneNumber))
        {
            _error = "Укажите полный номер телефона в формате +7 (XXX) XXX-XX-XX.";
            return;
        }
        if (_model.PositionId <= 0)
        {
            _error = "Выберите должность.";
            return;
        }
        if (_model.DepartmentId <= 0)
        {
            _error = "Выберите отдел.";
            return;
        }

        _busy = true;
        try
        {
            var r = await Auth.SendRegisterEmailCodeAsync(
                _model.PhoneNumber, _model.FullName, _model.Password, _model.Email.Trim(),
                _model.PositionId, _model.DepartmentId);
            _lastDevRegisterCode = string.IsNullOrWhiteSpace(r.DevCode) ? null : r.DevCode.Trim();
            _step = RegisterStep.Code;
            _code = "";
        }
        catch (Exception ex)
        {
            _error = HttpApiErrorFormatter.HumanizeException(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendRegisterCodeAsync()
    {
        if (_busyVerify) return;
        _busy = true;
        _error = null;
        try
        {
            var r = await Auth.SendRegisterEmailCodeAsync(
                _model.PhoneNumber, _model.FullName, _model.Password, _model.Email.Trim(),
                _model.PositionId, _model.DepartmentId);
            _lastDevRegisterCode = string.IsNullOrWhiteSpace(r.DevCode) ? null : r.DevCode.Trim();
        }
        catch (Exception ex)
        {
            _error = HttpApiErrorFormatter.HumanizeException(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task VerifyRegisterAsync()
    {
        if (_busyVerify || string.IsNullOrWhiteSpace(_code)) return;
        _busyVerify = true;
        _error = null;
        try
        {
            await Auth.CompleteRegistrationWithEmailCodeAsync(_model.Email, _code);
            Nav.NavigateTo(MobileShell.IsSigningOnlyShell ? "/signing" : "/", replace: true);
        }
        catch (Exception ex)
        {
            _error = HttpApiErrorFormatter.HumanizeException(ex);
        }
        finally
        {
            _busyVerify = false;
        }
    }

    private void BackToFormAsync()
    {
        _step = RegisterStep.Form;
        _code = "";
        _error = null;
        _lastDevRegisterCode = null;
    }

    private void GoLogin() => Nav.NavigateTo("/login");

    private sealed class RegisterModel
    {
        [Required]
        public string FullName { get; set; } = "";

        [Required]
        public string PhoneNumber { get; set; } = "";

        public int PositionId { get; set; }

        public int DepartmentId { get; set; }

        [Required(ErrorMessage = "Укажите email")]
        [EmailAddress(ErrorMessage = "Введите корректный email")]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
